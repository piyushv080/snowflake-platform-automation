---
# Copy to vault.yml, fill in, then encrypt:
#   cp group_vars/env_dev/vault.yml.example group_vars/env_dev/vault.yml
#   ansible-vault encrypt group_vars/env_dev/vault.yml
# Only the ENCRYPTED vault.yml may be committed (CI checks this).

# Snowflake automation service user (created by 01_bootstrap.yml)
vault_sf_account: myorg-myaccount
vault_sf_user: SVC_PLATFORM_AUTOMATION
vault_sf_private_key: |
  -----BEGIN ENCRYPTED PRIVATE KEY-----
  ...paste the .p8 file content...
  -----END ENCRYPTED PRIVATE KEY-----
vault_sf_private_key_passphrase: change-me

# Passphrase for keys generated by bootstrap / rotation
vault_sf_new_key_passphrase: change-me-too

# Human admin used ONLY by 01_bootstrap.yml (key-pair user with ACCOUNTADMIN)
vault_sf_admin_user: MY_ADMIN_USER
vault_sf_admin_private_key: |
  -----BEGIN ENCRYPTED PRIVATE KEY-----
  ...
  -----END ENCRYPTED PRIVATE KEY-----
vault_sf_admin_private_key_passphrase: change-me

# Windows management host (WinRM) used by sf_user_lifecycle
vault_win_user: CORP\svc_ansible_ad
vault_win_password: change-me

# ServiceNow (only needed when servicenow_enabled: true)
vault_servicenow_host: https://devXXXXX.service-now.com
vault_servicenow_username: ansible.integration
vault_servicenow_password: change-me
