<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Snowflake credit report - {{ sf_env }}</title>
<style>
  body { font-family: Segoe UI, Arial, sans-serif; margin: 2rem; color: #1f2937; }
  table { border-collapse: collapse; min-width: 640px; }
  th, td { border: 1px solid #d1d5db; padding: .4rem .8rem; text-align: right; }
  th:first-child, td:first-child { text-align: left; }
  th { background: #29b5e8; color: #fff; }
</style>
</head>
<body>
<h1>Snowflake credit report ({{ sf_env }})</h1>
<p>Window: last {{ sf_monitoring_cost_days }} days. Source: SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_METERING_HISTORY.
{% if sf_monitoring_price_per_credit %}Estimated cost uses {{ sf_monitoring_price_per_credit }} per credit.{% endif %}</p>
<table>
  <tr><th>Warehouse</th><th>Credits</th><th>Compute</th><th>Cloud services</th>{% if sf_monitoring_price_per_credit %}<th>Est. cost</th>{% endif %}</tr>
{% for r in sf_cost.rows %}
  <tr><td>{{ r.warehouse_name | e }}</td><td>{{ r.credits }}</td><td>{{ r.compute_credits }}</td><td>{{ r.cloud_services_credits }}</td>{% if sf_monitoring_price_per_credit %}<td>{{ ((r.credits | float) * (sf_monitoring_price_per_credit | float)) | round(2) }}</td>{% endif %}</tr>
{% endfor %}
</table>
<p>Generated by Ansible role sf_monitoring.</p>
</body>
</html>
