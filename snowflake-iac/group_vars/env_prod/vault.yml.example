---
# Same keys as group_vars/env_dev/vault.yml.example, with production values.
#   cp group_vars/env_prod/vault.yml.example group_vars/env_prod/vault.yml
#   ansible-vault encrypt --vault-id prod@prompt group_vars/env_prod/vault.yml
vault_sf_account: myorg-myprodaccount
vault_sf_user: SVC_PLATFORM_AUTOMATION
vault_sf_private_key: "<paste the full .p8 file here as a | block, including its BEGIN and END lines>"
vault_sf_private_key_passphrase: change-me
vault_sf_new_key_passphrase: change-me-too
vault_sf_admin_user: MY_ADMIN_USER
vault_sf_admin_private_key: "<paste the full .p8 file here as a | block, including its BEGIN and END lines>"
vault_sf_admin_private_key_passphrase: change-me
vault_win_user: CORP\svc_ansible_ad
vault_win_password: change-me
vault_servicenow_host: https://yourcompany.service-now.com
vault_servicenow_username: ansible.integration
vault_servicenow_password: change-me
